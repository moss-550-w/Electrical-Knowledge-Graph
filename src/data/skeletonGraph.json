  { "id": "s_electrostatics", "name": "静电场", "category": "电磁学", "level": "L2", "summary": "静电场研究不动电荷产生的电场和电位分布，电容是其核心集总参数，在电机中涉及绕组匝间绝缘和寄生电容分析。", "relations": [{ "target": "maxwell_equations", "type": "depends_on", "weight": 0.7 }] },
  { "id": "s_magnetostatics", "name": "静磁场", "category": "电磁学", "level": "L2", "summary": "静磁场研究恒定电流产生的磁场，电感是其核心集总参数，永磁体工作点的设计和退磁分析都基于静磁场理论。", "relations": [{ "target": "maxwell_equations", "type": "depends_on", "weight": 0.7 }, { "target": "magnetic_circuit", "type": "strong_related", "weight": 0.8 }] },

  { "id": "s_thermal_management", "name": "热管理基础", "category": "工程基础", "level": "L2", "summary": "功率电子和电机系统的热设计涉及传导、对流、辐射三种传热方式，热阻模型和散热器选型是保证系统可靠性的关键。", "relations": [{ "target": "igbt_mosfet", "type": "strong_related", "weight": 0.5 }] },
