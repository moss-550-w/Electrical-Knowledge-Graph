  { "id": "s_ems", "name": "储能能量管理EMS", "category": "电力系统", "level": "L1", "summary": "储能能量管理系统（EMS）依据分时电价、负荷曲线与新能源出力优化充放电调度，实现削峰填谷、需量管理与全生命周期经济运行。", "relations": [{ "target": "grid_storage_application", "type": "depends_on", "weight": 0.7 }] },
