  { "id": "s_pfc", "name": "功率因数校正（PFC）", "category": "电力电子", "level": "L1", "summary": "PFC技术通过控制输入电流波形跟随输入电压正弦波形，提高功率因数，满足IEC 61000-3-2谐波标准。", "relations": [{ "target": "s_boost_converter", "type": "depends_on", "weight": 0.7 }] },

  { "id": "s_opamp_applications", "name": "运放典型应用电路", "category": "模拟电子", "level": "L2", "summary": "包括跟随器、求和放大器、积分器、微分器、仪表放大器等，是模拟信号调理的标准模块。", "relations": [{ "target": "opamp_comparator", "type": "depends_on", "weight": 0.9 }, { "target": "circuit_theory", "type": "depends_on", "weight": 0.6 }] },
  { "id": "s_active_filters", "name": "有源滤波器", "category": "模拟电子", "level": "L2", "summary": "利用运放和RC网络实现低通、高通、带通和带阻滤波器，相比无源滤波器具有增益灵活、阻抗匹配好等优势。", "relations": [{ "target": "s_opamp_applications", "type": "depends_on", "weight": 0.8 }] },
  { "id": "s_oscillator", "name": "振荡电路", "category": "模拟电子", "level": "L1", "summary": "振荡器利用正反馈和频率选择网络产生自激正弦振荡（如文氏电桥、Colpitts、晶体振荡器），是时钟和载波信号来源。", "relations": [{ "target": "electronics_basics", "type": "depends_on", "weight": 0.7 }] },
  { "id": "s_power_amplifier", "name": "功率放大器", "category": "模拟电子", "level": "L2", "summary": "功率放大器分为A类、B类、AB类和D类（数字功放），D类采用PWM方式实现极高效率，与栅极驱动电路有内在关联。", "relations": [{ "target": "electronics_basics", "type": "depends_on", "weight": 0.7 }, { "target": "gate_drive", "type": "strong_related", "weight": 0.5 }] },

