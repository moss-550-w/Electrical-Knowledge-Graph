  { "id": "s_sequential_logic", "name": "时序逻辑电路", "category": "数字电子", "level": "L2", "summary": "时序逻辑的输出与历史和当前输入均有关，包括锁存器、触发器、寄存器和计数器，是状态机和数字控制器的硬件基础。", "relations": [{ "target": "digital_electronics_basics", "type": "depends_on", "weight": 0.9 }, { "target": "s_combinational_logic", "type": "depends_on", "weight": 0.8 }] },
  { "id": "s_fpga", "name": "FPGA/CPLD", "category": "数字电子", "level": "L1", "summary": "FPGA通过可编程逻辑块和互连资源实现任意数字逻辑，在高速电机控制中可实现纳秒级PWM更新和定制并行处理。", "relations": [{ "target": "s_sequential_logic", "type": "depends_on", "weight": 0.8 }] },
  { "id": "s_mcu_architecture", "name": "微控制器架构", "category": "数字电子", "level": "L2", "summary": "MCU集成CPU、存储器、定时器、ADC和通信接口于单芯片。电机控制专用MCU额外集成高精度PWM模块、正交编码器接口和硬件故障保护。", "relations": [{ "target": "digital_electronics_basics", "type": "depends_on", "weight": 0.8 }, { "target": "pwm_generation", "type": "maps_to", "weight": 0.9 }] },

  { "id": "s_transformer", "name": "变压器", "category": "电磁学", "level": "L2", "summary": "变压器基于电磁感应原理实现电压/电流的变换和电气隔离，是电力系统的关键设备，也是理解耦合电感和电机绕组的基础。", "relations": [{ "target": "faraday_law", "type": "depends_on", "weight": 0.9 }, { "target": "magnetic_circuit", "type": "depends_on", "weight": 0.9 }] },
  { "id": "s_eddy_current", "name": "涡流效应", "category": "电磁学", "level": "L2", "summary": "时变磁场在导体中感应出涡流，导致损耗（铁芯发热）和集肤效应（高频电流趋向导体表面），是电机铁芯采用叠片结构的原因。", "relations": [{ "target": "faraday_law", "type": "depends_on", "weight": 0.8 }] },
  { "id": "s_relay_contactor", "name": "继电器与接触器", "category": "电磁学", "level": "L1", "summary": "利用电磁铁原理实现电路的远程通断控制。继电器用于信号级切换，接触器用于动力级大电流通断。", "relations": [{ "target": "magnetic_circuit", "type": "depends_on", "weight": 0.7 }] },

  { "id": "s_power_system_structure", "name": "电力系统结构", "category": "电力系统", "level": "L1", "summary": "发电→输电→变电→配电→用电的五级结构构成现代电力系统的基本架构，是理解电网运行和新能源并网的宏观框架。", "relations": [{ "target": "three_phase_ac", "type": "depends_on", "weight": 0.7 }, { "target": "s_transformer", "type": "depends_on", "weight": 0.7 }] },
  { "id": "s_grid_tied_inverter", "name": "并网逆变器", "category": "电力系统", "level": "L2", "summary": "并网逆变器将光伏/储能等直流源转换为与电网同步的交流电，需满足频率/电压/相位锁相和孤岛检测等并网标准。", "relations": [{ "target": "three_phase_inverter", "type": "depends_on", "weight": 0.8 }, { "target": "control_theory_basics", "type": "depends_on", "weight": 0.7 }] },
  { "id": "s_hvdc", "name": "高压直流输电", "category": "电力系统", "level": "L1", "summary": "HVDC通过整流-直流-逆变实现长距离大容量输电，避免了交流输电的电容充电电流和稳定性问题。", "relations": [{ "target": "s_rectifier", "type": "depends_on", "weight": 0.7 }] },

  { "id": "s_signal_sampling", "name": "信号采样与量化", "category": "信号处理", "level": "L2", "summary": "奈奎斯特采样定理指出：采样频率必须大于信号最高频率的两倍（fs>2fmax），否则会发生混叠。ADC的分辨率和采样率直接影响控制系统性能。", "relations": [{ "target": "fourier_analysis", "type": "depends_on", "weight": 0.8 }, { "target": "digital_electronics_basics", "type": "strong_related", "weight": 0.7 }] },
  { "id": "s_digital_filters", "name": "数字滤波器", "category": "信号处理", "level": "L2", "summary": "数字滤波器（FIR/IIR）通过软件算法实现信号滤波，可灵活调整截止频率，消除硬件滤波的温漂和容差问题。", "relations": [{ "target": "s_signal_sampling", "type": "depends_on", "weight": 0.8 }, { "target": "laplace_transform", "type": "maps_to", "weight": 0.9 }] },
  { "id": "s_dft_fft", "name": "DFT与快速傅里叶变换", "category": "信号处理", "level": "L2", "summary": "FFT将DFT的计算复杂度从O(N²)降至O(NlogN)，使得频谱分析可以在嵌入式MCU上实时执行，用于电机故障诊断和振动监测。", "relations": [{ "target": "fourier_analysis", "type": "depends_on", "weight": 0.9 }] },

