  { "id": "s_supercapacitor", "name": "超级电容", "category": "储能", "level": "L2", "summary": "超级电容通过双电层或赝电容机制储能，功率密度极高、可瞬时大电流充放且循环寿命达百万次，常与锂电池构成混合储能系统平抑功率突变。", "relations": [{ "target": "bess", "type": "strong_related", "weight": 0.6 }, { "target": "circuit_theory", "type": "depends_on", "weight": 0.6 }] },
