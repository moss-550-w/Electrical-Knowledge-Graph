  { "id": "s_stepper_motor", "name": "步进电机", "category": "电机学", "level": "L2", "summary": "步进电机将电脉冲信号转换为离散的角位移，每接收一个脉冲转动一个步距角，适合开环定位控制。", "relations": [{ "target": "s_dc_motor", "type": "strong_related", "weight": 0.5 }] },

  { "id": "s_buck_converter", "name": "Buck降压变换器", "category": "电力电子", "level": "L2", "summary": "Buck变换器是最基本的DC-DC降压拓扑，通过控制开关管的占空比将输入电压降压输出，是理解所有PWM变换器的基础。", "relations": [{ "target": "power_electronics_basics", "type": "depends_on", "weight": 0.9 }, { "target": "circuit_theory", "type": "depends_on", "weight": 0.7 }] },
  { "id": "s_boost_converter", "name": "Boost升压变换器", "category": "电力电子", "level": "L2", "summary": "Boost变换器是最基本的DC-DC升压拓扑，利用电感储能和续流二极管实现升压，广泛应用于PFC和电池供电系统。", "relations": [{ "target": "power_electronics_basics", "type": "depends_on", "weight": 0.9 }, { "target": "s_buck_converter", "type": "strong_related", "weight": 0.7 }] },
  { "id": "s_rectifier", "name": "整流电路", "category": "电力电子", "level": "L2", "summary": "整流电路将交流电转换为直流电，包括不控整流（二极管桥）和相控整流（晶闸管桥），是电网取电和直流电源的基础。", "relations": [{ "target": "power_electronics_basics", "type": "depends_on", "weight": 0.8 }, { "target": "semiconductor_physics", "type": "depends_on", "weight": 0.5 }] },
