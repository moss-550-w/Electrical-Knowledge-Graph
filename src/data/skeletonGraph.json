  { "id": "s_observer", "name": "状态观测器", "category": "控制理论", "level": "L2", "summary": "龙伯格观测器利用系统模型和可测量输出重构不可测状态变量，在无位置传感器FOC中实现转子位置/速度估计。", "relations": [{ "target": "s_state_space", "type": "depends_on", "weight": 0.9 }, { "target": "pmsm_vector_control", "type": "maps_to", "weight": 0.8 }] },
  { "id": "s_adaptive_control", "name": "自适应控制", "category": "控制理论", "level": "L1", "summary": "自适应控制根据系统特性变化在线调整控制器参数（如MRAC、STR），可应对电机参数随温度和工况变化导致的模型失配。", "relations": [{ "target": "control_theory_basics", "type": "depends_on", "weight": 0.7 }] },
