[
  { "id": "s_dc_motor", "name": "直流电机", "category": "电机学", "level": "L2", "summary": "直流电机是最早实现的电动-发电互逆装置，其换向器和电刷结构使电枢电流方向自动切换，转矩控制直观简单。", "relations": [{ "target": "faraday_law", "type": "depends_on", "weight": 0.8 }, { "target": "circuit_theory", "type": "depends_on", "weight": 0.7 }] },
  { "id": "s_induction_motor", "name": "感应电机（异步电机）", "category": "电机学", "level": "L2", "summary": "感应电机依靠定子旋转磁场在转子导条中感应出电流产生转矩，结构简单坚固，是工业传动中应用最广泛的电机类型。", "relations": [{ "target": "rotating_magnetic_field", "type": "depends_on", "weight": 0.9 }, { "target": "ac_motor_principles", "type": "strong_related", "weight": 0.9 }] },
